---
// Standalone layout for the BookOnRent pages under /bookonrent.
// These pages are unlisted: noindex, not linked from the main site, not in the sitemap.
import { BOR } from '../data/bookonrent';

interface Props {
  title: string;
  narrow?: boolean;
}
const { title, narrow = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: '/bookonrent', label: 'Pricing' },
  { href: '/bookonrent/account', label: 'My account' },
  { href: '/bookonrent/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title} · BookOnRent</title>
    <link rel="icon" href="/bookonrent/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/bookonrent" class="brand" aria-label="BookOnRent home">
          <img src="/bookonrent/icon.svg" alt="" width="34" height="34" />
          <span>BookOnRent</span>
        </a>
        <nav class="topnav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <a href="/bookonrent/signin" class="btn btn-outline btn-sm" id="auth-link">Sign in</a>
      </div>
    </header>

    <main class:list={['wrap', { narrow }]}>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} {BOR.business}. BookOnRent is a product of {BOR.business}, {BOR.country}.</span>
        <nav aria-label="Legal">
          <a href="/bookonrent/terms">Terms</a>
          <a href="/bookonrent/privacy">Privacy</a>
          <a href="/bookonrent/refund">Refund &amp; Cancellation</a>
          <a href="/bookonrent/contact">Contact</a>
        </nav>
      </div>
    </footer>

    <script type="module" is:inline>
      import { sb } from '/bookonrent/bor.js';
      const link = document.getElementById('auth-link');
      sb.auth.getSession().then(({ data }) => {
        if (data.session) {
          link.textContent = data.session.user.email;
          link.href = '/bookonrent/account';
          link.classList.add('is-user');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --navy: #10213f;
    --teal: #087e8b;
    --teal-dark: #056777;
    --blue: #1b6fc0;
    --bg: #f7fafc;
    --card: #ffffff;
    --border: #e4e8ef;
    --line: #eef1f5;
    --muted: #5f6b80;
    --body: #304261;
    --green: #16a34a;
    --orange: #f47b20;
    --red: #d93025;
    --info-bg: #f0f9ff;
    --info-border: #b7ddf0;
    --gold: #ffd27a;
    --radius: 14px;
    --grad: linear-gradient(90deg, #0e8c99, #1b78c8);
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--navy);
    background: var(--bg);
    line-height: 1.55;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; padding-top: 40px; padding-bottom: 64px; }
  a { color: var(--teal); }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 12px; }
  .wrap { width: 100%; max-width: 1220px; margin: 0 auto; padding: 0 20px; }
  .wrap.narrow { max-width: 760px; }

  .topbar { background: #fff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; }
  .topbar-inner { display: flex; align-items: center; gap: 24px; height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--teal-dark); font-weight: 700; font-size: 1.2rem; }
  .topnav { display: flex; gap: 24px; margin-left: auto; }
  .topnav a { color: var(--navy); text-decoration: none; font-weight: 500; font-size: .95rem; }
  .topnav a[aria-current='page'] { color: var(--teal); }
  #auth-link.is-user { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 12px; border: 0; padding: 13px 20px; font: inherit; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: filter .15s, transform .05s;
  }
  .btn:active { transform: translateY(1px); }
  .btn:disabled { opacity: .55; cursor: not-allowed; }
  .btn-primary { background: var(--grad); color: #fff; }
  .btn-primary:hover:not(:disabled) { filter: brightness(1.06); }
  .btn-outline { background: #fff; color: var(--teal); border: 1.5px solid var(--teal); }
  .btn-dark { background: #fff; color: var(--navy); border: 1.5px solid var(--navy); }
  .btn-gold { background: var(--gold); color: var(--navy); }
  .btn-danger { background: #fff; color: var(--red); border: 1.5px solid #f3b4ae; }
  .btn-sm { padding: 8px 16px; font-size: .9rem; border-radius: 999px; }
  .btn-block { width: 100%; }

  .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 1px 3px rgba(16,33,63,.05); }
  .pad { padding: 28px; }
  .muted { color: var(--muted); }
  .info { background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 12px; padding: 14px 16px; color: var(--body); }
  .error { background: #fdecea; border: 1px solid #f5c2bd; color: #8a1c12; border-radius: 12px; padding: 12px 14px; }
  .hidden { display: none !important; }
  .pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: .78rem; font-weight: 600; }
  .pill-green { background: #e3f6e7; color: var(--green); }
  .pill-orange { background: #fff1e3; color: #b45309; }
  .pill-teal { background: var(--teal); color: #fff; }

  label { display: block; font-weight: 500; margin-bottom: 6px; font-size: .95rem; }
  input[type='email'], input[type='text'] {
    width: 100%; font: inherit; font-size: 1.05rem; padding: 13px 14px; border-radius: 12px;
    border: 1.5px solid #cfd7e2; background: #fff; color: var(--navy);
  }
  input:focus-visible { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px rgba(8,126,139,.15); }
  .btn:focus-visible, a:focus-visible { outline: 3px solid rgba(8,126,139,.35); outline-offset: 2px; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .rows li:last-child { border-bottom: 0; }
  .rows li span:first-child { color: var(--muted); }
  .rows li span:last-child { font-weight: 600; text-align: right; }

  .legal h1 { font-size: 2rem; }
  .legal h2 { font-size: 1.2rem; margin-top: 32px; }
  .legal p, .legal li { color: var(--body); }

  .footer { border-top: 1px solid var(--border); background: #fff; font-size: .88rem; color: var(--muted); }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; padding-top: 22px; padding-bottom: 22px; }
  .footer nav { display: flex; flex-wrap: wrap; gap: 18px; }
  .footer a { color: var(--body); text-decoration: none; }

  @media (max-width: 720px) {
    .topnav { display: none; }
    #auth-link { margin-left: auto; }
    main { padding-top: 24px; }
    .pad { padding: 20px; }
  }
</style>
