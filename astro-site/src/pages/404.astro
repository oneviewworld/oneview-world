---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page Not Found | OneView" description="This page doesn't exist." canonicalPath="/404">
  <Nav />
  <main>
    <section class="not-found">
      <div class="container">
        <h1>404</h1>
        <p>This page doesn't exist.</p>
        <a href="/" class="btn btn-primary">Back to Home</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    padding: 180px 0;
    text-align: center;
  }
  .not-found h1 {
    font-size: 4rem;
    margin-bottom: 12px;
  }
  .not-found p {
    color: var(--text-secondary);
    margin-bottom: 32px;
  }
</style>
