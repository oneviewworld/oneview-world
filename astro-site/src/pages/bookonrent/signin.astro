---
import Layout from '../../layouts/BookOnRentLayout.astro';
---

<Layout title="Sign in" narrow>
  <div class="card pad signin">
    <section id="step-email">
      <h1>Sign in to BookOnRent</h1>
      <p class="muted">Use the same email as in the BookOnRent app. We'll email you a 6-digit code. New here? This creates your free account.</p>
      <form id="email-form" novalidate>
        <label for="email">Email address</label>
        <input id="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
        <button class="btn btn-primary btn-block" type="submit" id="send-btn">Send code</button>
      </form>
    </section>

    <section id="step-code" class="hidden">
      <h1>Enter the code</h1>
      <p class="muted">We sent a 6-digit code to <strong id="sent-to"></strong>. <a href="#" id="change-email">Change email</a></p>
      <form id="code-form" novalidate>
        <label for="code">6-digit code</label>
        <input id="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required class="code-input" />
        <button class="btn btn-primary btn-block" type="submit" id="verify-btn">Verify &amp; continue</button>
      </form>
      <p class="muted small">Didn't get it? Check spam, or <a href="#" id="resend">send a new code</a>.</p>
    </section>

    <p id="msg" class="error hidden" role="alert"></p>
    <p class="muted small terms">By continuing you agree to our <a href="/bookonrent/terms">Terms</a> and <a href="/bookonrent/privacy">Privacy Policy</a>.</p>
  </div>
</Layout>

<script type="module" is:inline>
  import { sb, safeNext, show } from '/bookonrent/bor.js';

  const next = safeNext(new URLSearchParams(location.search).get('next'));
  const $ = (id) => document.getElementById(id);
  const msg = $('msg');
  let email = '';

  const { data } = await sb.auth.getSession();
  if (data.session) location.replace(next);

  function fail(text) { msg.textContent = text; show(msg); }

  async function sendCode() {
    show(msg, false);
    $('send-btn').disabled = true;
    const { error } = await sb.auth.signInWithOtp({ email, options: { shouldCreateUser: true } });
    $('send-btn').disabled = false;
    if (error) {
      fail(error.status === 429 ? 'Too many attempts. Please wait a minute and try again.' : 'Could not send the code. Please check the email address.');
      return false;
    }
    $('sent-to').textContent = email;
    show($('step-email'), false);
    show($('step-code'));
    $('code').focus();
    return true;
  }

  $('email-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    email = $('email').value.trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail('Please enter a valid email address.');
    await sendCode();
  });

  $('code-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = $('code').value.replace(/\D/g, '');
    if (token.length !== 6) return fail('Enter the 6-digit code from the email.');
    show(msg, false);
    $('verify-btn').disabled = true;
    const { error } = await sb.auth.verifyOtp({ email, token, type: 'email' });
    $('verify-btn').disabled = false;
    if (error) return fail('That code is wrong or has expired. Please try again or send a new code.');
    location.replace(next);
  });

  $('resend').addEventListener('click', (e) => { e.preventDefault(); sendCode(); });
  $('change-email').addEventListener('click', (e) => {
    e.preventDefault();
    show($('step-code'), false);
    show($('step-email'));
    show(msg, false);
  });
</script>

<style>
  .signin { max-width: 460px; margin: 20px auto; }
  .signin h1 { font-size: 1.6rem; }
  form { display: grid; gap: 14px; margin: 18px 0 10px; }
  .code-input { font-size: 1.6rem !important; letter-spacing: .5em; text-align: center; }
  .small { font-size: .88rem; }
  .terms { margin: 18px 0 0; }
  #msg { margin-top: 12px; }
</style>
