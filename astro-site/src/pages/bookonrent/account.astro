---
import Layout from '../../layouts/BookOnRentLayout.astro';
---

<Layout title="My account" narrow>
  <h1>My account</h1>
  <div id="loading" class="muted">Loading…</div>

  <div id="content" class="stack hidden">
    <div class="card pad">
      <div class="head">
        <div>
          <span class="muted small">Current plan</span>
          <h2 id="plan"></h2>
        </div>
        <span class="pill" id="status"></span>
      </div>
      <div class="usage">
        <strong id="used"></strong>
        <div class="bar"><span id="bar"></span></div>
      </div>
      <ul class="rows" id="rows"></ul>
    </div>

    <div class="card pad" id="actions">
      <h3>Change plan</h3>
      <p class="muted" id="change-note">Need more books? Pick a bigger plan. Your books and rentals stay exactly as they are.</p>
      <a class="btn btn-primary" href="/bookonrent">See plans</a>
      <div id="cancel-box" class="hidden cancel">
        <hr />
        <h3>Cancel monthly plan</h3>
        <p class="muted">Your plan keeps working until <strong id="until"></strong>. After that your account goes back to Free (50 books). Nothing is deleted.</p>
        <button class="btn btn-danger" id="cancel">Cancel my plan</button>
      </div>
      <p id="msg" class="hidden" role="status"></p>
    </div>

    <div class="card pad">
      <h3>Account</h3>
      <ul class="rows">
        <li><span>Email</span><span id="email"></span></li>
        <li><span>Help</span><span><a href="mailto:hello@oneview.world">hello@oneview.world</a></span></li>
      </ul>
      <button class="btn btn-outline" id="signout">Sign out</button>
    </div>
  </div>
</Layout>

<script type="module" is:inline>
  import { sb, requireSession, getEntitlement, callFunction, formatDate, show } from '/bookonrent/bor.js';

  const $ = (id) => document.getElementById(id);
  const session = await requireSession();
  if (session) await load();

  async function load() {
    const [ent, { data: sub }] = await Promise.all([
      getEntitlement(),
      sb.from('subscriptions').select('status, current_period_end, razorpay_subscription_id').maybeSingle(),
    ]);
    const limit = ent.book_limit;
    $('plan').textContent = ent.plan_name;
    $('email').textContent = session.user.email;
    $('used').textContent = limit ? `${ent.books_used} of ${limit.toLocaleString('en-IN')} books used` : `${ent.books_used} books · no limit`;
    const pct = limit ? Math.min(100, (ent.books_used / limit) * 100) : 100;
    $('bar').style.width = pct + '%';
    $('bar').style.background = limit && pct >= 80 ? 'var(--orange)' : 'var(--teal)';

    const cancelled = sub?.status === 'cancelled';
    const statusText = { active: 'Active', pending: 'Payment retrying', halted: 'Payment failed', cancelled: 'Cancelled' }[ent.status] || 'Active';
    $('status').textContent = statusText;
    $('status').className = 'pill ' + (ent.status === 'active' ? 'pill-green' : 'pill-orange');

    const rows = [['Book limit', limit ? limit.toLocaleString('en-IN') + ' books' : 'Unlimited']];
    if (ent.billing === 'monthly') rows.push([cancelled ? 'Ends on' : 'Renews on', formatDate(ent.current_period_end)]);
    if (ent.billing === 'once') rows.push(['Valid till', 'Forever']);
    if (ent.billing === 'none') rows.push(['Valid till', 'No expiry']);
    $('rows').innerHTML = rows.map(([a, b]) => `<li><span>${a}</span><span>${b}</span></li>`).join('');

    if (ent.plan_id === 'lifetime') {
      $('change-note').textContent = 'You have the Lifetime plan: unlimited books, forever. Nothing more to buy.';
      $('actions').querySelector('.btn-primary').classList.add('hidden');
    }
    const canCancel = ent.billing === 'monthly' && sub?.status === 'active' && sub?.razorpay_subscription_id;
    $('until').textContent = formatDate(ent.current_period_end);
    show($('cancel-box'), !!canCancel);

    show($('loading'), false);
    show($('content'));
  }

  $('cancel').addEventListener('click', async () => {
    if (!confirm('Cancel your monthly plan? It keeps working until the end of the month you paid for.')) return;
    $('cancel').disabled = true;
    const msg = $('msg');
    try {
      await callFunction('cancel-subscription');
      msg.className = 'info';
      msg.textContent = 'Your plan is cancelled. It keeps working until the end of your paid month. You will not be charged again.';
      show($('cancel-box'), false);
    } catch (e) {
      msg.className = 'error';
      msg.textContent = e.message;
      $('cancel').disabled = false;
    }
  });

  $('signout').addEventListener('click', async () => {
    await sb.auth.signOut();
    location.replace('/bookonrent');
  });
</script>

<style>
  h1 { font-size: 2rem; }
  .stack { display: grid; gap: 18px; }
  .head { display: flex; justify-content: space-between; align-items: flex-start; }
  .head h2 { font-size: 1.7rem; margin: 2px 0 0; }
  .small { font-size: .88rem; }
  .usage { margin: 18px 0 8px; }
  .bar { height: 9px; background: #e9edf2; border-radius: 99px; overflow: hidden; margin-top: 8px; }
  .bar span { display: block; height: 100%; border-radius: 99px; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 24px 0 18px; }
  h3 { font-size: 1.15rem; }
  #msg { margin-top: 16px; }
</style>
