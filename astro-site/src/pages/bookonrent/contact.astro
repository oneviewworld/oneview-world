---
import Layout from '../../layouts/BookOnRentLayout.astro';
import { BOR } from '../../data/bookonrent';
---

<Layout title="Contact" narrow>
  <article class="legal">
    <h1>Contact us</h1>
    <p>BookOnRent is made by {BOR.business}. For help with your account, plans, payments or refunds, write to us. We reply within 2 working days.</p>

    <div class="card pad details">
      <ul class="rows">
        <li><span>Business</span><span>{BOR.business}</span></li>
        <li><span>Email</span><span><a href={`mailto:${BOR.email}`}>{BOR.email}</a></span></li>
        <li><span>Location</span><span>{BOR.address}</span></li>
        <li><span>Support hours</span><span>Mon–Sat, 10 am – 6 pm IST</span></li>
      </ul>
    </div>

    <h2>Payment or refund question?</h2>
    <p>Email us from your BookOnRent account email and include your Razorpay payment ID (it starts with <code>pay_</code> and is in your receipt email). See our <a href="/bookonrent/refund">Refund &amp; Cancellation Policy</a>.</p>
  </article>
</Layout>

<style>
  .details { margin: 24px 0; }
</style>
