---
import Layout from '../../layouts/BookOnRentLayout.astro';
---

<Layout title="Checkout">
  <h1>Checkout</h1>
  <div id="loading" class="muted">Loading…</div>

  <div id="content" class="grid hidden">
    <div class="left">
      <div class="card pad who">
        <div>
          <span class="muted small">Buying for</span>
          <div class="email" id="email"></div>
        </div>
        <a href="#" id="switch" class="small">Not you? Switch account</a>
      </div>

      <div class="card pad">
        <span class="muted small">Your plan</span>
        <div class="plan-head">
          <h2 id="plan-name"></h2>
          <div class="plan-price" id="plan-price"></div>
        </div>
        <ul class="rows" id="plan-rows"></ul>
        <div class="total"><span>Total today</span><strong id="total"></strong></div>
      </div>
      <p class="muted small">
        By paying you agree to the <a href="/bookonrent/terms">Terms</a> and
        <a href="/bookonrent/refund">Refund &amp; Cancellation Policy</a>.
        <a href="/bookonrent">Choose a different plan</a>.
      </p>
    </div>

    <aside class="paybox">
      <h2>Pay securely</h2>
      <p id="pay-note"></p>
      <ul>
        <li>UPI Autopay (GPay, PhonePe, Paytm)</li>
        <li>Credit / debit card</li>
        <li>Netbanking</li>
      </ul>
      <button id="pay" class="btn btn-block paybtn">Pay</button>
      <p id="msg" class="error hidden" role="alert"></p>
      <p class="small secured">🔒 Secured by Razorpay</p>
    </aside>
  </div>
</Layout>

<script src="https://checkout.razorpay.com/v1/checkout.js" is:inline defer></script>
<script type="module" is:inline>
  import { sb, requireSession, callFunction, getEntitlement, rupees, show } from '/bookonrent/bor.js';

  const $ = (id) => document.getElementById(id);
  const planId = new URLSearchParams(location.search).get('plan');
  const session = await requireSession();

  if (session) {
    const [{ data: plan }, ent] = await Promise.all([
      sb.from('plans').select('*').eq('id', planId).maybeSingle(),
      getEntitlement().catch(() => null),
    ]);
    if (!plan || plan.billing === 'none') location.replace('/bookonrent');
    else render(plan, ent);
  }

  function render(plan, ent) {
    const monthly = plan.billing === 'monthly';
    const next = new Date();
    next.setMonth(next.getMonth() + 1);
    $('email').textContent = session.user.email;
    $('plan-name').textContent = plan.name;
    $('plan-price').textContent = rupees(plan.price_paise) + (monthly ? ' / month' : ' one-time');
    $('total').textContent = rupees(plan.price_paise);
    const rows = [
      ['Book limit', plan.book_limit ? plan.book_limit.toLocaleString('en-IN') + ' books' : 'Unlimited'],
      ['Billing', monthly ? 'Monthly, renews automatically' : 'One-time, never expires'],
      monthly ? ['First renewal', next.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })] : ['Renewals', 'None'],
      monthly ? ['Cancel', 'Anytime from My account'] : ['Refund', 'Within 7 days, see policy'],
    ];
    if (ent && ent.billing === 'monthly' && ent.plan_id !== plan.id) {
      rows.push(['Current plan', `${ent.plan_name} (stops when this starts)`]);
    }
    $('plan-rows').innerHTML = rows.map(([a, b]) => `<li><span>${a}</span><span>${b}</span></li>`).join('');
    $('pay-note').textContent = monthly
      ? `You'll set up UPI Autopay or a card mandate. ${rupees(plan.price_paise)} is charged today and every month until you cancel.`
      : `${rupees(plan.price_paise)} is charged once. Your library gets unlimited books forever.`;
    $('pay').textContent = `Pay ${rupees(plan.price_paise)} with Razorpay`;
    show($('loading'), false);
    show($('content'));

    if (ent && ent.plan_id === plan.id && ent.status === 'active' && plan.billing === 'monthly') {
      fail(`You are already on the ${plan.name} plan.`);
      $('pay').disabled = true;
    }
    if (ent && ent.plan_id === 'lifetime') {
      fail('You already have the Lifetime plan. No payment needed.');
      $('pay').disabled = true;
    }
    $('pay').addEventListener('click', () => pay(plan));
  }

  function fail(text) { $('msg').textContent = text; show($('msg')); }

  async function pay(plan) {
    show($('msg'), false);
    $('pay').disabled = true;
    try {
      const c = await callFunction('create-checkout', { plan_id: plan.id });
      const options = {
        key: c.key_id,
        name: 'BookOnRent',
        description: `${plan.name} plan`,
        image: location.origin + '/bookonrent/icon.svg',
        prefill: { email: session.user.email },
        notes: { plan_id: plan.id },
        theme: { color: '#087E8B' },
        handler: () => location.assign(`/bookonrent/success?plan=${plan.id}`),
        modal: { ondismiss: () => { $('pay').disabled = false; } },
      };
      if (c.kind === 'subscription') options.subscription_id = c.subscription_id;
      else { options.order_id = c.order_id; options.amount = c.amount; options.currency = 'INR'; }
      const rzp = new window.Razorpay(options);
      rzp.on('payment.failed', (r) => fail(r.error?.description || 'Payment failed. No money was taken. Please try again.'));
      rzp.open();
    } catch (e) {
      fail(e.message);
      $('pay').disabled = false;
    }
  }

  $('switch').addEventListener('click', async (e) => {
    e.preventDefault();
    await sb.auth.signOut();
    location.replace('/bookonrent/signin?next=' + encodeURIComponent(location.pathname + location.search));
  });
</script>

<style>
  h1 { font-size: 2rem; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: start; }
  .left { display: grid; gap: 18px; }
  .who { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .email { font-weight: 600; font-size: 1.1rem; }
  .small { font-size: .88rem; }
  .plan-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 4px; }
  .plan-head h2 { font-size: 1.8rem; margin: 0; }
  .plan-price { font-size: 1.4rem; font-weight: 700; }
  .total { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 16px; margin-top: 4px; font-size: 1.1rem; font-weight: 600; }
  .total strong { font-size: 1.4rem; }
  .paybox { background: linear-gradient(135deg, #087e8b, #1b6fc0); color: #fff; border-radius: 18px; padding: 28px; box-shadow: 0 16px 40px rgba(8,126,139,.25); }
  .paybox p { color: #d7eef2; }
  .paybox ul { list-style: none; padding: 0; margin: 18px 0 22px; display: grid; gap: 8px; }
  .paybox li { background: rgba(255,255,255,.14); border-radius: 10px; padding: 10px 14px; }
  .paybtn { background: #fff; color: var(--teal-dark); font-size: 1.05rem; padding: 15px; }
  .secured { text-align: center; margin: 14px 0 0; }
  #msg { margin-top: 14px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
