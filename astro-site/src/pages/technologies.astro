---
import DetailLayout from '../layouts/DetailLayout.astro';
import DetailCard from '../components/DetailCard.astro';
import { technologyAreas } from '../data/technologies';
---

<DetailLayout
  title="Technologies | OneView"
  description="The languages, frameworks, and platforms OneView uses to build mobile, web, desktop, backend, AI, and game software, from Flutter and Swift to React, .NET, and Python."
  canonicalPath="/technologies/"
  section="technologies"
  eyebrow="Technologies"
  heading="Technologies We Work With"
  intro={[
    'We are not tied to one framework. For every project we choose the stack that fits your users, budget, timeline, and team — native when performance and platform feel matter most, cross-platform when you need to launch everywhere quickly.',
    'Everything is built on proven, well-supported technology, documented as we go, and handed over with full source code and accounts, so any developer can pick it up after us.',
  ]}
  highlights={[
    { value: `${technologyAreas.length}`, label: 'Technology areas' },
    { value: 'iOS · Android', label: 'Native & cross-platform' },
    { value: 'Web · Desktop', label: 'Windows, macOS & Linux' },
    { value: '100%', label: 'Code ownership for you' },
  ]}
  jump={technologyAreas.map((a) => ({ href: `#${a.slug}`, label: a.name }))}
  cta={{
    title: 'Not sure which stack is right for you?',
    text: "Tell us what you want to build and we'll recommend the approach, with a realistic cost and timeline.",
  }}
>
  {technologyAreas.map((a) => (
    <DetailCard
      id={a.slug}
      icon={a.icon}
      color={a.color}
      title={a.name}
      description={a.description}
      groups={[
        { label: 'Languages', items: a.languages },
        { label: a.languages.length > 0 ? 'Frameworks & tools' : 'Platforms & tools', items: a.frameworks },
      ]}
    />
  ))}
</DetailLayout>
