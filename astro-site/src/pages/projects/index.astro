---
import { getCollection } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';

const domainGradients: Record<string, [string, string]> = {
  Gaming: ['#EC4899', '#8B5CF6'],
  'AI & Security': ['#6366F1', '#06B6D4'],
  Hospitality: ['#F59E0B', '#EF4444'],
  Logistics: ['#10B981', '#3B82F6'],
  Healthcare: ['#10B981', '#06B6D4'],
  Communication: ['#3B82F6', '#6366F1'],
  Productivity: ['#8B5CF6', '#EC4899'],
};

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.isFeatured) - Number(a.data.isFeatured) || a.data.featuredOrder - b.data.featuredOrder
);
const domains = new Set(projects.map((p) => p.data.domain));
const onAppStore = projects.filter((p) => p.data.appStoreUrl).length;
---

<DetailLayout
  title="Featured Work | OneView"
  description="Real products on the App Store and in daily production use — built by OneView. Games, AI platforms, healthcare software, logistics, and more."
  canonicalPath="/projects/"
  section="projects"
  eyebrow="Projects"
  heading="Featured Work"
  intro={[
    'Real products on the App Store and in daily production use — built by OneView, not mockups.',
    'From arcade games and AI-powered security platforms to hospital management and logistics software, each project below was designed, built, and shipped by the same team you would work with.',
  ]}
  highlights={[
    { value: `${projects.length}`, label: 'Products built' },
    { value: `${domains.size}`, label: 'Industries' },
    { value: `${onAppStore}`, label: 'Live on the App Store' },
    { value: 'Mobile · Web · AI', label: 'Platforms covered' },
  ]}
  jump={projects.map((p) => ({ href: `#${p.slug}`, label: p.data.title }))}
  cta={{
    title: 'Want your product on this page?',
    text: "Tell us about your idea and we'll show you how we would build it, with a realistic cost and timeline.",
  }}
>
  {projects.map((p) => {
    const [c1, c2] = domainGradients[p.data.domain] ?? ['#6366F1', '#06B6D4'];
    const cover = p.data.screenshots[0];
    return (
      <a id={p.slug} href={`/projects/${p.slug}/`} class="project-card fade-in">
        <div class={`cover ${p.data.isScreenshotLandscape ? '' : 'portrait'}`} style={`background: linear-gradient(135deg, ${c1}, ${c2})`}>
          {cover && <img src={cover} alt={p.data.title} loading="lazy" />}
        </div>
        <div class="project-body">
          <span class="domain-badge" style={`color:${c1}; border-color:${c1}55`}>{p.data.domain}</span>
          <h2>{p.data.title}</h2>
          <p>{p.data.subtitle}</p>
        </div>
      </a>
    );
  })}
</DetailLayout>

<style>
  .project-card {
    scroll-margin-top: 96px;
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--card);
  }
  .cover {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover.portrait {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 22px;
  }
  .cover.portrait img {
    width: 42%;
    height: auto;
    object-fit: cover;
    object-position: top;
    border-radius: 18px 18px 0 0;
    box-shadow: 0 10px 30px rgba(17, 24, 39, 0.28);
  }
  .project-body {
    padding: 22px;
  }
  .domain-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .project-body h2 {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .project-body p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
