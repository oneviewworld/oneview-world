---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const p = project.data;
---

<Layout
  title={`${p.title} — ${p.subtitle} | OneView`}
  description={p.subtitle + ' — a project by OneView. ' + p.techStack.join(', ')}
  canonicalPath={`/projects/${project.slug}`}
>
  <Nav />
  <main>
    <article class="project-detail">
      <div class="container">
        <a href="/projects" class="back-link">← All projects</a>

        <div class="header fade-in">
          <span class="domain-badge">{p.domain}</span>
          <h1>{p.title}</h1>
          <p class="subtitle">{p.subtitle}</p>
          {p.appStoreUrl && (
            <a href={p.appStoreUrl} class="btn btn-outline" target="_blank" rel="noopener">
              View on App Store <Icon name="arrow-right" size={16} />
            </a>
          )}
        </div>

        <div class="overview fade-in">
          <Content />
        </div>

        <div class="grid grid-2 fade-in">
          <div class="card">
            <h3>Key Features</h3>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div class="card">
            <h3>Key Deliverables</h3>
            <ul>{p.keyDeliverables.map((d) => <li>{d}</li>)}</ul>
          </div>
        </div>

        <div class="tech-row fade-in">
          <h3>Tech Stack</h3>
          <div class="chips">{p.techStack.map((t) => <span class="chip">{t}</span>)}</div>
        </div>

        {p.screenshots.length > 0 && (
          <div class={`gallery fade-in ${p.isScreenshotLandscape ? 'landscape' : ''}`}>
            <h3>Screenshots</h3>
            <div class="gallery-grid">
              {p.screenshots.map((src) => (
                <img src={src} alt={p.title} loading="lazy" />
              ))}
            </div>
          </div>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .project-detail {
    padding: 140px 0 40px;
  }
  .back-link {
    display: inline-block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .header {
    margin-bottom: 32px;
  }
  .domain-badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 8px;
  }
  .subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin: 0 0 20px;
  }
  .overview {
    max-width: 760px;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 48px;
    font-size: 1.05rem;
  }
  .card h3 {
    font-size: 1.1rem;
    margin: 0 0 16px;
  }
  .card ul {
    margin: 0;
    padding-left: 20px;
    color: var(--text-secondary);
  }
  .card li {
    margin-bottom: 10px;
  }
  .tech-row {
    margin: 40px 0;
  }
  .tech-row h3 {
    margin: 0 0 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .gallery h3 {
    margin: 0 0 20px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gallery.landscape .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery-grid img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }
  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
