---
import Icon from './Icon.astro';
import { technologyAreas } from '../data/technologies';
---

<section id="technologies" data-bg="wash" class="section-alt">
  <div class="container-wide">
    <div class="section-header fade-in">
      <span class="eyebrow">Technologies</span>
      <h2>Built With Modern<br />Technology Stack</h2>
      <p>Mobile, web, desktop, and everything behind them — we pick the right tools for your product, without locking you in later.</p>
    </div>

    <ul class="areas fade-in" aria-label="Technology areas we work in">
      {technologyAreas.map((a) => (
        <li>
          <a class="tech" href={`/technologies#${a.slug}`} style={`--dot:${a.color}`}>
            <span class="ic"><Icon name={a.icon} size={18} /></span>{a.name}
          </a>
        </li>
      ))}
      <li>
        <a class="tech more" href="/technologies">View all technologies <Icon name="arrow-right" size={16} /></a>
      </li>
    </ul>
  </div>
</section>

<style>
  .areas {
    list-style: none; margin: 0 auto; padding: 0; max-width: 1040px;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 14px;
  }
  .tech {
    display: inline-flex; align-items: center; gap: 10px; white-space: nowrap;
    padding: 12px 20px 12px 14px; border-radius: 16px;
    background: var(--card); border: 1px solid var(--border);
    box-shadow: var(--shadow-sm); color: var(--text);
    font-weight: 600; font-size: 0.98rem;
    transition: transform 0.3s var(--ease), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .tech:hover { transform: translateY(-4px) scale(1.03); box-shadow: var(--shadow-md); border-color: var(--dot); }
  .ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 10px;
    color: var(--dot); background: color-mix(in srgb, var(--dot) 14%, transparent);
  }
  .tech.more {
    --dot: var(--color-primary);
    padding: 12px 20px; color: #fff; border-color: transparent;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  }
  @media (max-width: 640px) {
    .tech { white-space: normal; font-size: 0.92rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tech, .tech:hover { transition: none; transform: none; }
  }
</style>
