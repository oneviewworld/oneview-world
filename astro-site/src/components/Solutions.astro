---
import Icon from './Icon.astro';
import Carousel from './Carousel.astro';
import { solutions } from '../data/solutions';
---

<section id="solutions" class="section-alt">
  <div class="container-wide">
    <div class="section-header fade-in">
      <span class="eyebrow">Solutions</span>
      <h2>Industry-Specific<br />Digital Solutions</h2>
      <p>Whatever you are building, chances are we have already shipped something close to it.</p>
    </div>

    <Carousel label="Industries we serve, scrollable" cardWidth="clamp(250px, 23vw, 300px)" cardWidthMobile="74%">
      {solutions.map((s) => (
        <div class="card fade-in solution-card">
          <div class="icon-badge"><Icon name={s.icon} /></div>
          <h3 class="card-title">{s.title}</h3>
          <p class="card-desc">{s.description}</p>
        </div>
      ))}
    </Carousel>
  </div>
</section>

<style>
  .solution-card {
    padding: 24px;
  }
  .card-title {
    font-size: 1.05rem;
    margin: 16px 0 8px;
  }
  .card-desc {
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin: 0;
  }
</style>
