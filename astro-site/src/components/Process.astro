---
import { processSteps } from '../data/process';
---

<section id="process" data-bg="grid">
  <div class="container">
    <div class="section-header fade-in">
      <span class="eyebrow">Our Process</span>
      <h2>From Idea to<br />Delivery</h2>
      <p>You always know what is being built, what it costs, and when it ships.</p>
    </div>

    <ol class="timeline">
      <div class="rail" aria-hidden="true"><div class="fill"></div></div>
      {processSteps.map((step) => (
        <li class="step fade-in">
          <div class="node" aria-hidden="true"><span>{step.number}</span></div>
          <div class="step-card card">
            <div class="step-num gradient-text">{step.number}</div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    --p: 0;
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 980px;
    display: grid;
    gap: 0;
  }
  /* Cards alternate sides, so each row is half empty; pull rows up so they interlock. */
  .step + .step { margin-top: -44px; }
  .rail {
    position: absolute; top: 24px; bottom: 24px; left: 50%; width: 3px; margin-left: -1.5px;
    border-radius: 3px; background: var(--border); overflow: hidden;
  }
  .fill {
    width: 100%; height: 100%; background: var(--gradient-primary);
    transform-origin: top; transform: scaleY(var(--p));
  }
  .step { display: grid; grid-template-columns: 1fr 52px 1fr; align-items: start; }
  .node {
    grid-column: 2; grid-row: 1; justify-self: center; z-index: 1;
    width: 44px; height: 44px; border-radius: 50%; margin-top: 18px;
    display: grid; place-items: center;
    background: var(--surface); border: 2px solid var(--border);
    color: var(--text-tertiary); font-size: 0.72rem; font-weight: 800;
    transition: all 0.5s var(--ease);
  }
  .step.active .node {
    background: var(--gradient-primary); color: #fff; border-color: transparent;
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--color-primary) 18%, transparent);
    transform: scale(1.08);
  }
  .step-card { grid-row: 1; padding: 22px 24px; }
  .step:nth-child(odd) .step-card { grid-column: 1; text-align: right; }
  .step:nth-child(even) .step-card { grid-column: 3; }
  .step-num { font-size: 1.6rem; font-weight: 800; opacity: 0.55; line-height: 1; }
  .step-card h3 { font-size: 1.1rem; margin: 10px 0 8px; }
  .step-card p { color: var(--text-secondary); font-size: 0.9rem; margin: 0; }

  @media (max-width: 760px) {
    .timeline { gap: 18px; }
    .step + .step { margin-top: 0; }
    .rail { left: 22px; }
    .step { grid-template-columns: 44px 1fr; column-gap: 16px; }
    .node { grid-column: 1; justify-self: start; }
    .step:nth-child(n) .step-card { grid-column: 2; text-align: left; }
  }
</style>
