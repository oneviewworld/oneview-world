---
import Icon from './Icon.astro';
import { site } from '../data/site';

const lines = site.heroHeadline.split('\n');
---

<section id="home" class="hero">
  <div class="aurora" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
  </div>
  <div class="dots" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="badge-row" style="--d:0">
        <span class="available-badge">
          <span class="dot"><i></i></span> Available for new projects
        </span>
        <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener"><Icon name="instagram" size={18} /></a>
        <a href={site.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin" size={18} /></a>
        <a href={site.social.reddit} aria-label="Reddit" target="_blank" rel="noopener"><Icon name="reddit" size={18} /></a>
      </div>

      <h1 class="hero-headline">
        {lines.map((l, i) => (
          <span class="line"><span class="line-inner gradient-text" style={`--l:${i}`}>{l}</span></span>
        ))}
      </h1>
      <p class="hero-description" style="--d:3">{site.heroDescription}</p>

      <div class="hero-actions" style="--d:4">
        <a href="/projects" class="btn btn-primary">View Our Work <Icon name="arrow-right" size={18} /></a>
        <a href="/#contact" class="btn btn-outline">Start Your Project <Icon name="rocket" size={18} /></a>
      </div>

      <div class="stats" style="--d:5">
        {site.stats.map((s) => (
          <div class="stat">
            <div class="stat-value gradient-text" data-count>{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="orb"></div>
      <div class="phone phone-1" style="--depth:14; --fd:-1s"><img src="/assets/projects/bounceup/screen_1.jpg" alt="" width="414" height="900" loading="eager" /></div>
      <div class="phone phone-2" style="--depth:30; --fd:-3s"><img src="/assets/projects/digital-butler/screen_1.jpg" alt="" width="414" height="900" loading="eager" /></div>
      <div class="phone phone-3" style="--depth:18; --fd:-5s"><img src="/assets/projects/bookonrent/screen_1.jpg" alt="" width="416" height="900" loading="eager" /></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 132px 0 104px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- aurora + dot grid ---- */
  .aurora { position: absolute; inset: 0; z-index: -2; pointer-events: none; }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .b1 { width: 520px; height: 520px; top: -160px; left: -80px; background: #818cf8; }
  .b2 { width: 460px; height: 460px; top: -60px; right: -60px; background: #22d3ee; animation-delay: -6s; opacity: 0.4; }
  .b3 { width: 420px; height: 420px; bottom: -180px; left: 38%; background: #c084fc; animation-delay: -11s; opacity: 0.35; }
  :root[data-theme='dark'] .blob { opacity: 0.28; }
  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(50px, 36px, 0) scale(1.14); }
  }
  .dots {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(color-mix(in srgb, var(--text) 16%, transparent) 1px, transparent 1.2px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 20%, transparent 75%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }

  /* ---- entrance choreography (CSS only, independent of JS/IO) ---- */
  .hero-copy > *:not(.hero-headline) {
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(var(--d, 0) * 90ms + 60ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(22px); filter: blur(8px); }
  }
  .hero-headline {
    font-size: clamp(2.3rem, 5vw, 3.7rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 0 0 24px;
  }
  @media (min-width: 1000px) { .line { white-space: nowrap; } }
  .line { display: block; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .line-inner {
    display: inline-block;
    text-wrap: balance;
    animation: lineUp 1.1s var(--ease) both;
    animation-delay: calc(0.12s + var(--l) * 0.14s);
  }
  .line:nth-child(2) .line-inner { background-image: linear-gradient(120deg, #8b5cf6, #06b6d4); }
  @keyframes lineUp { from { transform: translateY(108%); } }

  .badge-row { display: flex; align-items: center; gap: 12px; margin-bottom: 30px; flex-wrap: wrap; }
  .available-badge {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 16px; border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 9%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    color: var(--color-primary); font-weight: 600; font-size: 0.85rem;
  }
  .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); }
  .dot i {
    position: absolute; inset: 0; border-radius: 50%; background: var(--color-success);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }
  .badge-row a {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary);
    transition: transform 0.3s var(--ease), color 0.2s ease, border-color 0.2s ease;
  }
  .badge-row a:hover { transform: translateY(-3px); color: var(--color-primary); border-color: var(--color-primary); }

  .hero-description { max-width: 560px; color: var(--text-secondary); font-size: 1.15rem; line-height: 1.7; margin: 0 0 38px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 52px; }
  .stats { display: flex; flex-wrap: wrap; gap: 14px 44px; }
  .stat-value { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stat-label { color: var(--text-secondary); font-size: 0.88rem; }

  /* ---- phones: depth parallax (JS) + idle float (CSS) ---- */
  .hero-visual { position: relative; display: flex; justify-content: center; align-items: center; gap: 14px; min-height: 540px; }
  .orb {
    position: absolute; width: 70%; aspect-ratio: 1; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 30%, transparent), transparent 68%);
    filter: blur(20px);
  }
  .phone {
    width: 30%; max-width: 190px; padding: 6px; border-radius: 28px;
    background: var(--card); border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    translate: calc(var(--px, 0) * var(--depth, 10) * 1px) calc(var(--py, 0) * var(--depth, 10) * 1px + var(--float, 0px));
    animation: float 7s ease-in-out infinite;
    animation-delay: var(--fd, 0s);
    transition: translate 0.25s ease-out;
  }
  .phone img { width: 100%; height: auto; aspect-ratio: 9 / 19.5; object-fit: cover; object-position: top; border-radius: 22px; display: block; }
  .phone-1 { transform: translateY(38px) rotate(-4deg); }
  .phone-2 { transform: translateY(-26px); z-index: 2; width: 34%; max-width: 212px; }
  .phone-3 { transform: translateY(38px) rotate(4deg); }
  @keyframes float { 0%, 100% { --float: 0px; } 50% { --float: -14px; } }


  @media (max-width: 900px) {
    .hero { padding-top: 20px; padding-bottom: 72px; }
    .hero-inner { grid-template-columns: 1fr; gap: 28px; }
    .hero-visual { min-height: 0; padding: 20px 0 32px; }
  }
  @media (max-width: 640px) {
    .b1 { width: 300px; height: 300px; top: -130px; left: -110px; opacity: 0.45; }
    .b2 { width: 260px; height: 260px; top: -50px; right: -120px; opacity: 0.3; }
    .b3 { display: none; }
    .hero-copy { text-align: center; }
    .hero-actions, .stats { justify-content: center; }
    /* One row: status badge left, social icons right; headline is centered on the next row */
    .badge-row { flex-wrap: nowrap; justify-content: flex-start; gap: 6px; margin-bottom: 26px; }
    .available-badge { padding: 6px 11px; gap: 7px; font-size: 0.74rem; white-space: nowrap; margin-right: auto; }
    .badge-row a { width: 30px; height: 30px; flex: 0 0 auto; }
    .badge-row a :global(svg) { width: 15px; height: 15px; }
    .hero-description { margin-left: auto; margin-right: auto; }
    .phone { border-radius: 20px; padding: 4px; }
    .phone img { border-radius: 16px; }
    .hero-actions .btn { flex: 1 1 100%; justify-content: center; }
  }

  @media (max-width: 360px) {
    .available-badge { padding: 5px 9px; font-size: 0.68rem; }
    .badge-row a { width: 27px; height: 27px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob, .phone, .dot i { animation: none; }
    .hero-copy > *, .line-inner { animation: none; }
  }
</style>
