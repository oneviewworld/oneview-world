---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="home" class="hero">
  <div class="container hero-inner">
    <div class="hero-copy fade-in">
      <div class="badge-row">
        <span class="available-badge">
          <span class="dot"></span> Available for new projects
        </span>
        <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener"><Icon name="instagram" size={18} /></a>
        <a href={site.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener"><Icon name="linkedin" size={18} /></a>
        <a href={site.social.reddit} aria-label="Reddit" target="_blank" rel="noopener"><Icon name="reddit" size={18} /></a>
      </div>

      <h1 class="hero-headline gradient-text">{site.heroHeadline}</h1>
      <p class="hero-description">{site.heroDescription}</p>

      <div class="hero-actions">
        <a href="/projects" class="btn btn-primary">View Our Work <Icon name="arrow-right" size={18} /></a>
        <a href="#contact" class="btn btn-outline">Start Your Project <Icon name="rocket" size={18} /></a>
        <a href="/blog" class="btn btn-outline">Blog</a>
      </div>

      <div class="stats">
        {site.stats.map((s) => (
          <div>
            <div class="stat-value gradient-text">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="phone phone-1"><img src="/assets/projects/bounceup/screen_1.jpg" alt="" width="414" height="900" loading="eager" /></div>
      <div class="phone phone-2"><img src="/assets/projects/digital-butler/screen_1.jpg" alt="" width="414" height="900" loading="eager" /></div>
      <div class="phone phone-3"><img src="/assets/projects/healthx-patients/screen_1.jpg" alt="" width="540" height="1170" loading="eager" /></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 140px 0 96px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 600px;
    background: radial-gradient(
      ellipse at top,
      color-mix(in srgb, var(--color-primary) 18%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .available-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
  }

  .badge-row a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    min-height: 520px;
  }

  .phone {
    width: 30%;
    max-width: 190px;
    border-radius: 26px;
    padding: 6px;
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: 0 24px 60px color-mix(in srgb, var(--color-primary) 22%, transparent),
      0 4px 14px rgba(17, 24, 39, 0.08);
  }

  .phone img {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 19.5;
    object-fit: cover;
    object-position: top;
    border-radius: 20px;
  }

  .phone-1 { transform: translateY(36px) rotate(-3deg); }
  .phone-2 { transform: translateY(-24px); z-index: 2; max-width: 210px; width: 34%; }
  .phone-3 { transform: translateY(36px) rotate(3deg); }

  .hero-headline {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    white-space: pre-line;
    margin: 0 0 24px;
  }

  .hero-description {
    max-width: 620px;
    color: var(--text-secondary);
    font-size: 1.15rem;
    margin: 0 0 40px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 56px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 800;
  }

  .stat-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-visual {
      min-height: 0;
      padding-bottom: 24px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 110px;
      text-align: center;
    }
    .phone { border-radius: 18px; padding: 4px; }
    .phone img { border-radius: 14px; }
    .badge-row,
    .hero-actions {
      justify-content: center;
    }
    .stats {
      justify-content: center;
    }
  }
</style>
