---
import Icon from './Icon.astro';

interface Props {
  /** Accessible name for the scrollable region. */
  label: string;
  /** Card width on desktop/tablet (any CSS length/clamp). */
  cardWidth?: string;
  /** Card width on phones. */
  cardWidthMobile?: string;
}
const { label, cardWidth = 'clamp(270px, 29vw, 420px)', cardWidthMobile = '80%' } = Astro.props;
---

<div class="carousel-root" data-carousel-root style={`--card-w:${cardWidth}; --card-w-m:${cardWidthMobile}`}>
  <div class="carousel-head">
    <div class="progress" aria-hidden="true"><span class="thumb"></span></div>
    <div class="arrows">
      <button type="button" class="arrow prev" aria-label={`Previous — ${label}`} data-carousel-prev disabled>
        <Icon name="arrow-right" size={18} />
      </button>
      <button type="button" class="arrow next" aria-label={`Next — ${label}`} data-carousel-next>
        <Icon name="arrow-right" size={18} />
      </button>
    </div>
  </div>

  <div class="carousel" data-carousel tabindex="0" role="region" aria-label={label}>
    <slot />
  </div>
</div>

<style>
  .carousel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 4px;
  }
  .carousel-root.no-scroll .carousel-head { display: none; }

  /* Scroll-position indicator: replaces a "swipe to browse" text hint. */
  .progress {
    --w: 1;
    --x: 0;
    position: relative;
    flex: 0 1 220px;
    height: 4px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--text) 12%, transparent);
    overflow: hidden;
  }
  .thumb {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(var(--w) * 100%);
    left: calc(var(--x) * (100% - var(--w) * 100%));
    border-radius: 4px;
    background: var(--gradient-primary);
    transition: left 0.15s linear;
  }

  .arrows { display: flex; gap: 10px; }
  .arrow {
    width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    background: var(--surface); color: var(--text);
    border: 1.5px solid color-mix(in srgb, var(--text) 22%, transparent);
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s var(--ease), background 0.2s ease, color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }
  .arrow:hover:not(:disabled) { background: var(--gradient-primary); color: #fff; border-color: transparent; transform: scale(1.06); }
  .arrow:active:not(:disabled) { transform: scale(0.94); }
  .arrow:disabled { opacity: 0.35; cursor: default; }
  .arrow.prev :global(svg) { transform: rotate(180deg); }

  /* One row, scrolls sideways with snap. Padding gives hover lift/shadows room (overflow clips them). */
  .carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 24px;
    margin: 0 -24px;
    padding: 20px 24px 36px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    outline-offset: -4px;
  }
  .carousel::-webkit-scrollbar { display: none; }
  .carousel.dragging { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; }
  .carousel.dragging > :global(*) { pointer-events: none; }
  .carousel > :global(*) {
    flex: 0 0 var(--card-w);
    scroll-snap-align: start;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 640px) {
    .carousel { margin: 0 -20px; padding: 16px 20px 28px; scroll-padding-inline: 20px; }
    .carousel > :global(*) { flex-basis: var(--card-w-m); scroll-snap-align: center; }
    .arrows { display: none; }
    .progress { flex: 1 1 auto; max-width: none; }
  }
  @media (hover: none) {
    .arrows { display: none; }
    .carousel { cursor: auto; }
    .progress { flex: 1 1 auto; max-width: none; }
  }
</style>

<script>
  function initCarousel(root: HTMLElement) {
    const sc = root.querySelector<HTMLElement>('[data-carousel]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const prog = root.querySelector<HTMLElement>('.progress');
    if (!sc) return;

    const visibleCards = () => [...sc.children].filter((c) => !(c as HTMLElement).hidden) as HTMLElement[];
    const step = () => {
      const c = visibleCards()[0];
      return c ? c.getBoundingClientRect().width + 20 : 320;
    };
    const update = () => {
      const max = sc.scrollWidth - sc.clientWidth;
      root.classList.toggle('no-scroll', max <= 4);
      if (prev) prev.disabled = sc.scrollLeft <= 4;
      if (next) next.disabled = sc.scrollLeft >= max - 4;
      if (prog && sc.scrollWidth > 0) {
        prog.style.setProperty('--w', Math.min(1, sc.clientWidth / sc.scrollWidth).toFixed(4));
        prog.style.setProperty('--x', (max > 0 ? Math.min(1, Math.max(0, sc.scrollLeft / max)) : 0).toFixed(4));
      }
    };

    prev?.addEventListener('click', () => sc.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => sc.scrollBy({ left: step(), behavior: 'smooth' }));
    sc.addEventListener('scroll', update, { passive: true });
    sc.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { sc.scrollBy({ left: step(), behavior: 'smooth' }); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { sc.scrollBy({ left: -step(), behavior: 'smooth' }); e.preventDefault(); }
    });
    addEventListener('resize', update);
    // Filters hide/show cards, which changes scrollWidth without a scroll event.
    new ResizeObserver(update).observe(sc);
    new MutationObserver(() => { sc.scrollTo({ left: 0, behavior: 'auto' }); update(); })
      .observe(sc, { subtree: true, attributes: true, attributeFilter: ['hidden'] });
    update();

    // Mouse drag-to-scroll (touch and trackpads already scroll natively).
    let down = false, moved = false, startX = 0, startLeft = 0;
    sc.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = false; startX = e.clientX; startLeft = sc.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) { moved = true; sc.classList.add('dragging'); }
      if (moved) sc.scrollLeft = startLeft - dx;
    });
    const end = () => {
      if (!down) return;
      down = false;
      if (moved) {
        const s = step();
        sc.classList.remove('dragging');
        sc.scrollTo({ left: Math.round(sc.scrollLeft / s) * s, behavior: 'smooth' });
      }
    };
    addEventListener('pointerup', end);
    addEventListener('pointercancel', end);
    // A drag must not count as a click on a card link.
    sc.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel-root]').forEach(initCarousel);
</script>
